 com.sap.adt.tools.cloud.authentication.ui;resolution:=optional,
 com.sap.adt.util;resolution:=optional
Bundle-RequiredExecutionEnvironment: JavaSE-21
Automatic-Module-Name: ninja.abap.adt_auto_logon
